# Environment variables read by the Osbourne stack.
#
# Copy this file to `.env` to override the defaults below:
#
#   cp .env.example .env
#
# Every value mirrors the hardcoded default that is used when the variable is
# unset, so leaving `.env` absent changes nothing. The one exception is
# SEED_DATA, where the compose file sets `true` explicitly.
#
# Docker Compose does not interpolate `.env` into the services' `environment:`
# blocks, so changing a value here does NOT change the running stack. This is a
# deliberate, documented limitation: the RabbitMQ guest/guest pair is required
# by the compose defaults and cannot be overridden from `.env`.

# Shared by every service: validates JWTs and signs new ones. In production
# this must be a long random string, and must be identical across the stack.
JWT_SECRET=dev-secret-change-me

# RabbitMQ connection string the services publish to / consume from. The
# credentials match RABBITMQ_DEFAULT_USER / RABBITMQ_DEFAULT_PASS below.
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Credentials the rabbitmq container is created with. guest:guest is the
# stock RabbitMQ default and is left as-is for local development; the
# dashboard is reachable at http://localhost:15672.
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Each service owns an embedded SQLite database. The per-service defaults
# differ, so a single value only matters when a service is run on its own:
#   auth-service       ./auth.db
#   profile-service    ./profiles.db
#   notification-svc   ./notification.db
#   course-catalogue   ./course-catalogue.db
#   assignment-service ./data/assignment.db
DB_PATH=

# Course Content Service's CloverDB document store directory.
NOSQL_PATH=content-db

# Assignment Service's submission file storage.
UPLOAD_DIR=./data/uploads

# Whether the Assignment Service seeds demo assignments and files on start.
# The compose file sets this to true; the code default when unset is false.
SEED_DATA=true

# Log level for the structured JSON loggers: debug | info | warn | error.
LOG_LEVEL=info

# Auth Service: lifetime of an issued JWT, in minutes.
TOKEN_TTL_MINUTES=120

# REST listener port for every backend service (the nginx api-gateway dials
# all of them on 8080, so changing one here silently would 502 every route).
HTTP_PORT=8080

# Frontend gRPC dial targets for the six backend services.
AUTH_SERVICE_ADDR=dns:///auth-service:50056
PROFILE_SERVICE_ADDR=dns:///profile-service:50051
NOTIFICATION_SERVICE_ADDR=dns:///notification-service:50052
COURSE_CATALOGUE_SERVICE_ADDR=dns:///course-catalogue-service:50053
COURSE_CONTENT_SERVICE_ADDR=dns:///course-content-service:50054
ASSIGNMENT_SERVICE_ADDR=dns:///assignment-service:50055