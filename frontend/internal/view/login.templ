package view

// LoginPage posts straight to auth-service through the api-gateway. The cookie
// is set by that response, so the browser never sees the token: this form has
// no server-side handler to hand it to, which is the whole point of the move.
templ LoginPage(data PageData, errorMsg string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<title>Sign in - Osborne.AI Portal</title>
			<link rel="stylesheet" href="/static/css/style.css"/>
		</head>
		<body>
			<div class="login-shell">
				<h2>Osborne.AI Portal</h2>
				<p>Sign in to continue</p>

				<form id="login-form">
					<label for="email-input">Email</label>
					<input type="email" name="email" id="email-input" placeholder="student@osbourne.local" required autocomplete="username"/>
					<label for="password-input">Password</label>
					<input type="password" name="password" id="password-input" required autocomplete="current-password"/>
					<button type="submit" id="login-button">Sign in</button>
				</form>

				if errorMsg != "" {
					<p class="login-error" id="login-error">{ errorMsg }</p>
				}

				<div class="demo-accounts">
					<p class="demo-accounts-title">Demo accounts</p>
					<ul class="demo-accounts-list">
						<li class="demo-account">
							<span class="demo-account-role">Student</span>
							<span class="demo-account-name">Andy Osborne</span>
							<code>student@osbourne.local / student123</code>
						</li>
						<li class="demo-account">
							<span class="demo-account-role">Teacher</span>
							<span class="demo-account-name">Dr. Jane Teacher</span>
							<code>teacher@osbourne.local / teacher123</code>
						</li>
					</ul>
				</div>
			</div>

			<script>
				document.getElementById('login-form').addEventListener('submit', function (event) {
					event.preventDefault();

					var button = document.getElementById('login-button');
					var error = document.getElementById('login-error');
					if (button) button.disabled = true;
					if (error) error.textContent = '';

					fetch('/api/auth/login', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({
							email: document.getElementById('email-input').value,
							password: document.getElementById('password-input').value
						})
					})
						.then(function (resp) {
							return resp.json().catch(function () { return {}; }).then(function (data) {
								return { ok: resp.ok, data: data };
							});
						})
						.then(function (result) {
							// The Set-Cookie has already landed by now, so a
							// full navigation picks it up. A client-side route
							// change would not re-run the session check.
							if (result.ok) {
								window.location.href = '/';
								return;
							}
							if (button) button.disabled = false;
							showLoginError(error, result.data.message || 'Sign in failed');
						})
						.catch(function () {
							if (button) button.disabled = false;
							showLoginError(error, 'Could not reach the server');
						});
				});

				function showLoginError(element, message) {
					if (!element) {
						alert(message);
						return;
					}
					element.textContent = message;
					element.classList.add('visible');
				}
			</script>
		</body>
	</html>
}
