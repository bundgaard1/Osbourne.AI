        ],
        "tags": [
          "AuthService"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "summary": "Empties the session cookie. Deliberately unauthenticated: a client whose\ntoken has already expired must still be able to drop it.",
        "operationId": "AuthService_Logout",
