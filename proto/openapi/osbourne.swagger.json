{
  "swagger": "2.0",
  "info": {
    "title": "assignment/assignment.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "AssignmentService"
    },
    {
      "name": "AuthService",
      "description": "The REST annotations on this service are the platform's session boundary:\nLogin mints the `osbourne_session` cookie and Logout expires it, so the\nauth-service owns session issuance rather than the frontend."
    },
    {
      "name": "CourseCatalogueService"
    },
    {
      "name": "CourseContentService",
      "description": "Modules are addressed as a sub-resource of a course, so every route carries\n{course_id} even for the single-module operations. The service still looks the\nmodule up by {module_id} alone; {course_id} scopes the route and is available\nfor a consistency check."
    },
    {
      "name": "NotificationService"
    },
    {
      "name": "ProfileService",
      "description": "Both RPCs are exposed on the same path: the caller is always the bearer of the\nJWT, so there is no user id in the URL to get wrong."
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
