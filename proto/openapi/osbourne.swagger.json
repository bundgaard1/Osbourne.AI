            }
          }
        },
        "tags": [
          "AuthService"
        ]
      }
    },
    "/api/auth/validate": {
      "post": {
        "summary": "Stateless token introspection, for clients that cannot verify the\nsignature themselves. Takes no Authorization header: the token being\nvalidated is the payload.",
